__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache/
.ipynb_checkpoints/

# Archivos de prueba
data/pruebas/*
!data/pruebas/.gitkeep
*.zip

# VS Code
.vscode/

# Playwright
playwright-report/
test-results/
