# ── Base de datos PostgreSQL ───────────────────────────────────────────────────
# Copia este archivo como .env y ajusta usuario/contraseña

# Local
DATABASE_URL=postgresql://carroya_user:TU_CONTRASEÑA@localhost:5432/carroya

# Cloud (Neon) — descomenta y pega la URL de tu proyecto en neon.tech
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/carroya?sslmode=require

# ── Notificaciones por email (opcional) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
TIMEZONE=America/Bogota
