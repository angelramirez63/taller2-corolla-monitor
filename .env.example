# ── Cadena de conexión PostgreSQL ─────────────────────────────────────────────
# Copia este archivo como .env y ajusta usuario/contraseña

# Local
DATABASE_URL=postgresql://carroya_user:TU_CONTRASEÑA@localhost:5432/carroya

